<!-- Views/EquityOptimizationChartWindow.xaml -->
<Window x:Class="MoneyGenerator_v5.Views.EquityOptimizationChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="График эквити оптимизации" Height="550" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="StatLabelStyle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="StatValueStyle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с параметрами -->
        <Border Grid.Row="0" Background="White" Padding="10" Margin="0,0,0,10" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="📈 График эквити" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="{Binding ParametersSummary}" FontSize="11" Foreground="#7F8C8D" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Статистика -->
        <Border Grid.Row="1" Background="White" Padding="10" Margin="0,0,0,10" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="Нач. капитал:"/>
                    <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding InitialCapital, StringFormat=F2}" Foreground="#2980B9"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="Кон. капитал:"/>
                    <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding FinalCapital, StringFormat=F2}" 
                               Foreground="{Binding FinalCapitalColor}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="P&amp;L:"/>
                    <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding TotalProfit, StringFormat=F2}" 
                               Foreground="{Binding ProfitColor}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="Макс. просадка %:"/>
                    <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding MaxDrawdown, StringFormat=F1 }"  Foreground="#E74C3C"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="Период:"/>
                    <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding TotalDuration}" Foreground="#7F8C8D"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- График -->
        <Border Grid.Row="2" Background="White" CornerRadius="5" Padding="5">
            <ScottPlot:WpfPlot x:Name="EquityPlot" />
        </Border>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Вся история" Command="{Binding SetFullHistoryCommand}" 
                    Margin="5" Padding="15,8" Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="⟳ Обновить" Command="{Binding RefreshCommand}" 
                    Margin="5" Padding="15,8" Background="#2ECC71" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="💾 Экспорт" Command="{Binding ExportCommand}" 
                    Margin="5" Padding="15,8" Background="#F39C12" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="✖ Закрыть" Click="CloseButton_Click" 
                    Margin="5" Padding="15,8" Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>