<Window x:Class="MoneyGenerator_v5.Views.EquityChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="График эквити" Height="600" Width="900"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="📊 График эквити" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="{Binding AccountName}" Margin="20,0,0,0" FontSize="14" Foreground="Gray"/>
            <TextBlock Text="{Binding PeriodText}" Margin="20,0,0,0" FontSize="12" Foreground="DarkGray"/>
        </StackPanel>

        <!-- График - сам WpfPlot, который будет отображать данные -->
        <ScottPlot:WpfPlot x:Name="EquityPlot" Grid.Row="1"/>

        <!-- Панель управления -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
            <Button Content="30 дней" Command="{Binding SetPeriodCommand}" CommandParameter="30" 
            Margin="5" Padding="10,5" Width="80"/>
            <Button Content="90 дней" Command="{Binding SetPeriodCommand}" CommandParameter="90" 
            Margin="5" Padding="10,5" Width="80"/>
            <Button Content="180 дней" Command="{Binding SetPeriodCommand}" CommandParameter="180" 
            Margin="5" Padding="10,5" Width="80"/>
            <Button Content="365 дней" Command="{Binding SetPeriodCommand}" CommandParameter="365" 
            Margin="5" Padding="10,5" Width="80"/>
            <Button Content="Вся история" Command="{Binding SetPeriodCommand}" CommandParameter="0" 
            Margin="5" Padding="10,5" Width="100"/>
            <Button Content="⟳ Обновить" Command="{Binding RefreshCommand}" 
            Margin="5" Padding="10,5" Width="80"/>
            <Button Content="💾 Экспорт" Command="{Binding ExportCommand}" 
            Margin="5" Padding="10,5" Width="80"/>
        </StackPanel>
    </Grid>
</Window>